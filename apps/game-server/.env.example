# Must match apps/api/.env JWT_SECRET exactly — game-server verifies tokens signed by the API (D-05)
JWT_SECRET=<same value as apps/api/.env JWT_SECRET>
PORT=2567
# Must be exactly 'development' or 'test' to enable dev-only backdoors (isDevEnv allowlist — Pitfall 8)
NODE_ENV=development
# Browser origin pinned on matchmake-route CORS in production; leave empty in dev (same-origin via Vite proxy)
CORS_ORIGIN=
